# ==========================================
# FEATHER & BONE - PRIVATE / GENERATED FILES
# ==========================================


# ==========================================
# DEPENDENCIES
# ==========================================
node_modules/
**/node_modules/


# ==========================================
# ENVIRONMENT VARIABLES & SECRETS
# ==========================================
.env
.env.*
**/.env
**/.env.*

# Allow safe example environment files
!.env.example
!**/.env.example

# ...and the frontend's PRODUCTION build config, which holds no secrets.
#
# Every VITE_ variable is inlined by Vite into the JavaScript that ships to
# every visitor's browser, so nothing in this file can be private — it is
# public the moment the site is deployed, by construction. What it does hold is
# the API address the production bundle is compiled against, and leaving that
# untracked means the build is not reproducible: whoever builds next gets a
# bundle pointing wherever their own machine happens to be configured, which is
# exactly how a production site ends up calling http://localhost:7000.
#
# Deliberately narrow. Only this one path is exempt; backend/.env and every
# other .env stay ignored, because those DO hold secrets.
!frontend/.env.production


# ==========================================
# PRIVATE DOCUMENTATION
# ==========================================
README.md
GUIDE.md
DEPLOYMENT_GUIDE.md

# Ignore documentation in any subfolder
**/README.md
**/GUIDE.md
**/DEPLOYMENT_GUIDE.md


# ==========================================
# BUILD FILES
# ==========================================
dist/
build/
.next/
out/

**/dist/
**/build/
**/.next/
**/out/


