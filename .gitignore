!.vscode/settings.json

.idea/
*.iml


# ==========================================
# DATABASE FILES
# ==========================================
*.sqlite
*.sqlite3
*.db

# ANCHORED WITH A LEADING SLASH — these mean a local mongod data directory at
# the PROJECT ROOT, nothing else. Unanchored, `database/` matches a directory of
# that name at ANY depth, and this repository has one: backend/src/database/,
# which is application source. connect.js survives only because it was committed
# before the rule existed; git ignores nothing already tracked. Any NEW file put
# beside it would have been silently untracked — absent from commits, absent
# from every deployment archive — and would fail in production while working
# perfectly on the machine that wrote it. The two characters are the whole fix.
/data/
/database/


# ==========================================
# BACKUPS
# ==========================================
*.bak
*.backup
backups/
backup/


# ==========================================
# CERTIFICATES / PRIVATE KEYS
# ==========================================
*.pem
*.key
*.crt
*.pfx
*.p12


# ==========================================
# CLOUD / DEPLOYMENT SECRETS
# ==========================================
.firebase/
.vercel/
.render/
.aws/


# ==========================================
# MISC
# ==========================================
*.swp
*.swo
*~