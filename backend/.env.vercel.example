# ===========================================================================
# Feather & Bone API — environment variables for VERCEL
# ===========================================================================
# Vercel does not read .env files. Put these in:
#   Vercel → your project → Settings → Environment Variables
# The form accepts a pasted .env: fill in the values below, paste the whole
# block, and choose the "Production" environment only. (Previews then have no
# database and refuse to start, instead of writing to the live shop's data.)
#
# After changing any variable: Deployments → ⋯ → Redeploy. Running functions
# keep the values they started with.
#
# Full procedure: deploy/VERCEL.md
# ===========================================================================

NODE_ENV=production
API_PREFIX=/api/v1

# MongoDB Atlas. Vercel's outbound IPs change constantly, so Atlas → Network
# Access must allow 0.0.0.0/0 (the username/password still protect the data).
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/featherbonepk?retryWrites=true&w=majority

# The storefront on WebHoster. Exact origins — no trailing slash, no path.
CLIENT_URL=https://featherbonepk.com
ALLOWED_ORIGINS=https://www.featherbonepk.com

# Three DIFFERENT random values, 32+ characters each: openssl rand -hex 32
# The API refuses to start while any still contains "change-me".
JWT_ACCESS_SECRET=change-me-access-secret-use-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-refresh-secret-use-openssl-rand-hex-32
JWT_POS_SECRET=change-me-pos-secret-use-openssl-rand-hex-32

# Email is required in production. The WebHoster mailbox works from Vercel:
# cPanel → Email Accounts → noreply@featherbonepk.com → Connect Devices.
APP_NAME=Feather & Bone
SMTP_HOST=mail.featherbonepk.com
SMTP_PORT=465
SMTP_USER=noreply@featherbonepk.com
SMTP_PASSWORD=
MAIL_FROM=Feather & Bone <noreply@featherbonepk.com>

# Uploads MUST go to Cloudinary on Vercel — functions have no permanent disk,
# and the API refuses to start with UPLOAD_DRIVER=local there.
# cloudinary.com → Dashboard → API Keys.
UPLOAD_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=feather-and-bone
# Vercel rejects request bodies over 4.5 MB, so uploads are capped at 4 MB there
# whatever these say; they are set to match so the messages agree.
UPLOAD_MAX_MB=4
UPLOAD_VIDEO_MAX_MB=4

# Protects the daily sweep in vercel.json (abandoned-payment stock, forgotten
# kitchen tickets). Any random value: openssl rand -hex 32
CRON_SECRET=

# Payment methods (a gateway switched on without its credentials refuses to boot).
PAYMENT_COD_ENABLED=true
PAYMENT_JAZZCASH_ENABLED=false
PAYMENT_EASYPAISA_ENABLED=false
PAYMENT_BANK_TRANSFER_ENABLED=false
