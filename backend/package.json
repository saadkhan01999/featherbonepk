{
  "name": "@fb/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Feather & Bone API — Express + MongoDB service powering the website, POS and back office.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
