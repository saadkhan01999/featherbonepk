# ===========================================================================
# Feather & Bone API — environment template (WebHoster.pk / cPanel)
# ===========================================================================
# Copy this file to `.env` in the SAME folder as package.json — on cPanel that
# is the Node.js application root, e.g. /home/<cpanel-user>/featherbone-api/.env
# — and fill in every value marked ►. Then press Restart in Setup Node.js App.
#
# The app root must NOT be inside public_html or any domain's document root.
# This file holds the database password and the token secrets; inside a web
# root, Apache would serve it to anyone who asks for /.env.
#
# Values typed into the panel's "Environment variables" section win over this
# file (dotenv never overwrites a variable that is already set). Use one place
# or the other, not both, or you will edit the one that is being ignored.
#
# Check everything with:   npm run doctor     (cPanel: "Run JS script" → doctor)
# ===========================================================================

# --- Runtime -----------------------------------------------------------------
# cPanel's "Application mode: Production" also sets this; keep them agreeing.
NODE_ENV=production

# Ignored under cPanel: Passenger hands the app its own socket. Only used when
# you run `npm start` yourself in the terminal.
PORT=7000

# Every route lives under this prefix. If you change it, change VITE_API_URL in
# frontend/.env.production too — they are one setting written in two places.
API_PREFIX=/api/v1

# --- Database (MongoDB Atlas) ------------------------------------------------
# cPanel shared hosting has no MongoDB of its own; the data lives in Atlas.
#
# ► Atlas → Database → Connect → Drivers → copy the mongodb+srv:// string.
#   Put the database name after ".net/" (featherbone below), and percent-encode
#   any of  @ : / ? # %  in the password (e.g. @ → %40).
#
# ► Atlas → Network Access → allow the server's IP. Find it in cPanel's right
#   sidebar ("Shared IP Address"), or allow 0.0.0.0/0.
#
# ► WebHoster must allow OUTBOUND TCP port 27017 from your account. Many cPanel
#   hosts block it by default, and no Atlas setting can fix that. Test it after
#   uploading with:  npm run check:db   — "BLOCKED" means open a support ticket:
#   "Please allow outbound TCP 27017 to MongoDB Atlas (*.mongodb.net)."
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/featherbone?retryWrites=true&w=majority

# --- Who may call this API ---------------------------------------------------
# The storefront's address: the CORS origin, and the host used in password
# reset and email verification links. No trailing slash, no path.
CLIENT_URL=https://featherbonepk.com

# Other origins that serve the same site (comma separated, bare scheme+host).
ALLOWED_ORIGINS=https://www.featherbonepk.com

# --- Email (required in production — the API refuses to start without it) ----
# ► cPanel → Email Accounts → Create:  noreply@featherbonepk.com
#   Then "Connect Devices" on that account shows the secure SMTP settings.
#   Use the "Secure SSL/TLS" outgoing server it lists — usually
#   mail.featherbonepk.com, or the server's own name (speed.webhoster.pk) —
#   with port 465. `npm run doctor` logs in for real and says if it works.
APP_NAME="Feather & Bone"
SMTP_HOST=mail.featherbonepk.com
SMTP_PORT=465
SMTP_USER=noreply@featherbonepk.com
SMTP_PASSWORD=
MAIL_FROM="Feather & Bone <noreply@featherbonepk.com>"

# --- Token secrets -----------------------------------------------------------
# ► Three DIFFERENT random values, each 32+ characters. The API refuses to start
#   in production while any of them still contains "change-me". Generate each
#   one in the cPanel terminal (or on your PC) with:
#       openssl rand -hex 32
#   or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-use-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-refresh-secret-use-openssl-rand-hex-32
JWT_POS_SECRET=change-me-pos-secret-use-openssl-rand-hex-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_POS_EXPIRES_IN=12h

# --- Uploaded images and videos ----------------------------------------------
# cPanel storage is permanent, so the local driver is the right one here.
#
# Relative paths are resolved from this folder, so the value below means
# /home/<cpanel-user>/featherbone-uploads — BESIDE the app folder, not inside
# it, so replacing the app on a redeploy never deletes product photos.
UPLOAD_DRIVER=local
UPLOAD_DIR=../featherbone-uploads
UPLOAD_MAX_MB=5
UPLOAD_VIDEO_MAX_MB=50

# Only when UPLOAD_DRIVER=cloudinary (all three, or the API refuses to start).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=feather-and-bone

# --- Abandoned online-payment reservations -----------------------------------
# Only matters once JazzCash/EasyPaisa are on. Passenger may stop an idle app,
# which pauses the in-process sweeper; the cPanel cron job in
# deploy/WEBHOSTER.md (`npm run expire:reservations`) covers those gaps.
RESERVATION_MINUTES=30
RESERVATION_SWEEP_SECONDS=60

# --- Payment methods ---------------------------------------------------------
# A gateway switched on without its credentials refuses to boot.
PAYMENT_COD_ENABLED=true
PAYMENT_JAZZCASH_ENABLED=false
PAYMENT_EASYPAISA_ENABLED=false
PAYMENT_BANK_TRANSFER_ENABLED=false
COD_MAX_ORDER_VALUE=15000

# JazzCash (uncomment when PAYMENT_JAZZCASH_ENABLED=true; MODE is sandbox|live)
# JAZZCASH_MERCHANT_ID=
# JAZZCASH_PASSWORD=
# JAZZCASH_INTEGRITY_SALT=
# JAZZCASH_MODE=sandbox

# EasyPaisa (uncomment when PAYMENT_EASYPAISA_ENABLED=true; MODE is sandbox|live)
# EASYPAISA_STORE_ID=
# EASYPAISA_HASH_KEY=
# EASYPAISA_MODE=sandbox

# Bank transfer (uncomment when PAYMENT_BANK_TRANSFER_ENABLED=true)
# BANK_NAME=
# BANK_ACCOUNT_TITLE=
# BANK_ACCOUNT_NUMBER=
# BANK_IBAN=
# BANK_BRANCH=

# --- First owner account ------------------------------------------------------
# Not configured here. After the API connects, run once:
#   npm run owner -- --email you@featherbonepk.com
# It creates the super admin with a generated password and prints it ONCE.
# (With no --email it uses owner@featherandbone.pk; change it later in the
# admin profile, or with the same command.)

# --- Pricing defaults --------------------------------------------------------
CURRENCY=PKR
TAX_RATE=0.05
DELIVERY_FEE=60
FREE_DELIVERY_THRESHOLD=3000
